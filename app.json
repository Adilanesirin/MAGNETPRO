{
  "expo": {
    "name": "MagnetPro",
    "slug": "MagnetPro",
    "version": "3.3.5",
    "orientation": "portrait",
    "icon": "./assets/magnet-appicon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "3.3.5",
      "supportsTablet": true,
      "bundleIdentifier": "com.magnet.MagnetPro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "MagnetPro uses the microphone so Study Buddy can hear your spoken answers during live English speaking practice."
      }
    },
    "android": {
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/magnet-appicon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.magnet.MagnetPro"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6f542465-14a3-49ac-bd6c-a78214f6e6ad"
      }
    },
    "owner": "magnetpro_emp",
    "plugins": [
      "expo-asset",
      [
       "expo-audio",
        {
          "microphonePermission": "MagnetPro uses the microphone so Study Buddy can hear your spoken answers during live English speaking practice."
        }
      ],
      "expo-web-browser",
      "./plugins/withNoSplashScreen",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
